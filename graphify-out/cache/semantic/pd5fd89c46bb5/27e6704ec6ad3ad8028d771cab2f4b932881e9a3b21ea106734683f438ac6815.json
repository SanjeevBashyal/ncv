{"nodes": [{"id": "agents_ncv_architecture", "label": "ncv Architecture Layout", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Project Direction", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Main-window orchestration is isolated in ncv/app.py, shared panel behavior in ncv/ncvcommon.py, and each tab in its own ncv/ncv*.py module so tab implementations stay independently editable."}, {"id": "agents_runtime_ui_loading", "label": "Runtime .ui Loading with uic.loadUi", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Project Direction", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Qt Designer forms in ncv/ui/*.ui are loaded at runtime rather than compiled to Python, eliminating a generated-code step: editing a form and restarting the app is the whole edit loop, and no generated file can drift from its .ui source."}, {"id": "agents_toolkit_neutral_helpers", "label": "Toolkit-Neutral Helper Layer", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Development Notes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "NetCDF, session, and slicing logic is kept free of Qt so Qt widgets consume plain specs and values; this keeps the data layer testable without a GUI and swappable behind any toolkit."}, {"id": "agents_optional_cartopy_policy", "label": "Optional Cartopy Graceful Degradation", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Development Notes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cartopy is optional: a missing install must not break package import or app startup, so the Map tab degrades to an informational/disabled state. Only cartopy.crs and cartopy.feature are used (projection maths and Natural Earth geometry) because neither pulls in matplotlib; all rendering stays pyqtgraph."}, {"id": "agents_optional_xarray_policy", "label": "Optional xarray Backend Policy", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Development Notes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "xarray is optional; the --xarray path fails with a clear runtime message only when explicitly requested and unavailable, so the default netCDF4 path never pays for an absent dependency."}, {"id": "agents_dependency_exclusion_policy", "label": "Forbidden GUI/Plotting Dependencies", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Project Direction", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Package imports must not depend on Tk, CustomTkinter, matplotlib, or Cartopy, keeping the import graph to PyQt6 + pyqtgraph so startup stays light and the optional extras stay genuinely optional."}, {"id": "agents_single_launcher_name", "label": "Single Public Launcher Name", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": "Development Notes", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "`ncv` is the only public launcher name; no `ncvue` compatibility command or function is to be added, avoiding a second name to document, test, and keep working."}, {"id": "agents_offscreen_qt_testing", "label": "Offscreen Qt Testing Convention", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Useful Commands", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QT_QPA_PLATFORM=offscreen lets Qt window creation and .ui form loading be exercised headlessly in CI without a display server."}, {"id": "agents_testing_expectations", "label": "Testing Expectations", "file_type": "document", "source_file": "AGENTS.md", "source_location": "Testing Expectations", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Tests pin the architectural invariants themselves: import without Cartopy, absence of Tk/CustomTkinter/matplotlib imports, NcvSession.open() on generated files, offscreen window creation, every ncv/ui/*.ui form loading, and the Map tab present-but-informational without Cartopy."}, {"id": "agents_ncvsession_open", "label": "NcvSession.open()", "file_type": "concept", "source_file": "AGENTS.md", "source_location": "Testing Expectations", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "agents_ncv_architecture", "target": "agents_toolkit_neutral_helpers", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Project Direction", "weight": 1.0}, {"source": "agents_dependency_exclusion_policy", "target": "agents_ncv_architecture", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Project Direction", "weight": 1.0}, {"source": "agents_runtime_ui_loading", "target": "agents_ncv_architecture", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Project Direction", "weight": 1.0}, {"source": "agents_optional_cartopy_policy", "target": "agents_dependency_exclusion_policy", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Development Notes", "weight": 1.0}, {"source": "agents_testing_expectations", "target": "agents_optional_cartopy_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Testing Expectations", "weight": 1.0}, {"source": "agents_testing_expectations", "target": "agents_dependency_exclusion_policy", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Testing Expectations", "weight": 1.0}, {"source": "agents_testing_expectations", "target": "agents_ncvsession_open", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Testing Expectations", "weight": 1.0}, {"source": "agents_testing_expectations", "target": "agents_runtime_ui_loading", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Testing Expectations", "weight": 1.0}, {"source": "agents_testing_expectations", "target": "agents_offscreen_qt_testing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Testing Expectations", "weight": 1.0}, {"source": "agents_ncvsession_open", "target": "agents_toolkit_neutral_helpers", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "AGENTS.md", "source_location": "Testing Expectations", "weight": 1.0}, {"source": "readme_ncv_app_py", "target": "agents_ncv_architecture", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Project Direction", "weight": 1.0}, {"source": "readme_python_launcher", "target": "agents_single_launcher_name", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": "Development Notes", "weight": 1.0}, {"source": "readme_pyqtgraph_rendering", "target": "agents_dependency_exclusion_policy", "relation": "implements", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "AGENTS.md", "source_location": "Development Notes", "weight": 1.0}], "hyperedges": [{"id": "optional_dependency_degradation_pattern", "label": "Optional-Dependency Graceful Degradation Pattern", "nodes": ["agents_optional_cartopy_policy", "agents_optional_xarray_policy", "agents_dependency_exclusion_policy", "readme_optional_extras", "readme_map_tab", "readme_xarray_backend"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md"}]}